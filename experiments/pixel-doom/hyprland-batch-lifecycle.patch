+// Private pixel-doom experiment. Never active without the explicit environment
+// switch, and restricted to non-X11 floating experiment windows.
+static bool pixelDoomBatchLifecycle(const CWindow& window) {
+    static const bool enabled = std::getenv("HYPRLAND_PIXEL_DOOM_BATCH_LIFECYCLE") != nullptr;
+    return enabled && !window.m_isX11 && window.m_isFloating && window.m_class.starts_with("pixel-doom-");
+}
+
+static void pixelDoomQueueWorkspaceRefresh(const PHLWORKSPACE& workspace, bool unmap) {
+    struct PendingWorkspace {
+        PHLWORKSPACEREF workspace;
+        bool updateData;
+    };
+    static std::vector<PendingWorkspace> pending;
+    static bool scheduled = false;
+    static bool decorations = false;
+    static size_t requests = 0;
+    ++requests;
+    decorations |= unmap;
+    if (workspace) {
+        auto it = std::ranges::find_if(pending, [&](const auto& item) { return item.workspace.lock() == workspace; });
+        if (it == pending.end())
+            pending.push_back({workspace, unmap});
+        else
+            it->updateData |= unmap;
+    }
+    if (scheduled)
+        return;
+    scheduled = true;
+    static auto flush = [] {
+        // Detach the batch first, so reentrant changes schedule another pass.
+        auto work = std::move(pending);
+        pending.clear();
+        const bool updateDecorations = std::exchange(decorations, false);
+        const auto requestCount = std::exchange(requests, 0);
+        scheduled = false;
+        size_t workspaces = 0;
+        for (const auto& item : work) {
+            if (auto ws = item.workspace.lock()) {
+                ws->updateWindows();
+                if (item.updateData) {
+                    ws->updateWindowData();
+                    ws->forceReportSizesToWindows();
+                }
+                ++workspaces;
+            }
+        }
+        if (updateDecorations)
+            Desktop::globalWindowController()->updateAllWindowsDecorations();
+        Log::logger->log(Log::INFO, "pixel-doom lifecycle: {} requests, {} workspace passes, decorations={}", requestCount, workspaces, updateDecorations);
+    };
+    // A fixed deadline (not a sliding debounce) also combines closes that arrive
+    // in separate event-loop cycles. Zero retains the initial idle-only trial.
+    static const int delayMs = [] {
+        const auto value = std::getenv("HYPRLAND_PIXEL_DOOM_BATCH_MS");
+        return value ? std::clamp(std::atoi(value), 0, 16) : 8;
+    }();
+    if (!delayMs) {
+        g_pEventLoopManager->doLater(flush);
+        return;
+    }
+    static SP<CEventLoopTimer> timer;
+    if (!timer) {
+        timer = makeShared<CEventLoopTimer>(std::nullopt, [](SP<CEventLoopTimer>, void*) { flush(); }, nullptr);
+        g_pEventLoopManager->addTimer(timer);
+    }
+    timer->updateTimeout(std::chrono::milliseconds(delayMs));
+}
